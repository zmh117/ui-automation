{
  "name": "@mes-ui/config-enumerator",
  "version": "0.2.0",
  "private": true,
  "description": "框架无关的有限配置全量枚举，保留合法与非法组合",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./discovery": { "types": "./dist/discovery/index.d.ts", "import": "./dist/discovery/index.js" }
  },
  "bin": { "config-enumerate": "./bin/enumerate.mjs", "config-discover": "./bin/discover.mjs", "config-review": "./bin/review.mjs" },
  "files": ["dist", "bin", "examples", "README.md", "DISCOVERY.md", "VERIFICATION.md"],
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "enumerate": "node bin/enumerate.mjs",
    "discover": "node bin/discover.mjs",
    "review": "node bin/review.mjs",
    "test:discovery": "npm run build && node --test test/discovery/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": { "playwright": ">=1.63.0 <2" },
  "peerDependenciesMeta": { "playwright": { "optional": true } },
  "devDependencies": { "typescript": "5.9.3", "playwright": "1.63.0" }
}
